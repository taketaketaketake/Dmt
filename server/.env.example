# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dmt?schema=public"

# Server
PORT=3000
HOST=localhost
NODE_ENV=development

# Session
SESSION_SECRET="change-me-to-a-random-string-at-least-32-chars"
SESSION_MAX_AGE_DAYS=30

# Magic Link
MAGIC_LINK_EXPIRY_MINUTES=15
APP_URL="http://localhost:5173"

# Email (Resend)
# Optional in dev (emails are logged to the console); REQUIRED in production.
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Detroit Directory <noreply@yourdomain.com>"  # must be a Resend-verified domain

# Stripe (billing)
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"
STRIPE_PRICE_ID="price_xxxxxxxxxxxx"

# Cloudflare R2 (object storage for uploads)
# Optional in dev (falls back to local disk); REQUIRED in production.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="r2-access-key-id"
R2_SECRET_ACCESS_KEY="r2-secret-access-key"
R2_BUCKET="dmt-uploads"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"  # or your custom domain
